digraph G { graph[fontname="WenQuanYi Zen Hei", rankdir=TB, dpi=150]; node[fontname="WenQuanYi Zen Hei", shape=box, style=rounded]; edge[fontname="WenQuanYi Zen Hei"];
s[label="开始", shape=oval]; in[label="读取三个文本框 A、B、C", shape=parallelogram];
v[label="三边均为正整数？\n(非空、纯数字、>0、不溢出)", shape=diamond];
t[label="任意两边之和 > 第三边？\n(long 运算防溢出)", shape=diamond];
eq[label="A=B=C ？", shape=diamond]; iso[label="A=B 或 B=C 或 A=C ？", shape=diamond];
r1[label="输入不合法"]; r2[label="不能构成三角形"]; r3[label="等边三角形"]; r4[label="等腰三角形"]; r5[label="普通三角形"];
out[label="显示结果 (Label + MessageBox)", shape=parallelogram]; e[label="结束", shape=oval];
s->in->v; v->r1[label="否"]; v->t[label="是"]; t->r2[label="否"]; t->eq[label="是"];
eq->r3[label="是"]; eq->iso[label="否"]; iso->r4[label="是"]; iso->r5[label="否"];
{r1 r2 r3 r4 r5}->out->e; }
